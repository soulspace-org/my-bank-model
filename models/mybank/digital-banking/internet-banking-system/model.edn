   :to :mybank.digital-banking.internet-banking-system/view-account
   :name "supports"
   :desc "Provides account details"}
  {:el :uses
   :id :mybank.core-banking/account-management-system-supports-transfer-money
   :from :mybank.core-banking/account-management-system
   :to :mybank.digital-banking.internet-banking-system/transfer-money
   :name "supports"
   :desc "Books the transfer"}
  {:el :uses
   :id :mybank.core-banking/loan-management-system-supports-view-loan-status
   :from :mybank.core-banking/loan-management-system
   :to :mybank.digital-banking.internet-banking-system/view-loan-status
   :name "supports"
   :desc "Provides loan details"}
  {:el :uses
