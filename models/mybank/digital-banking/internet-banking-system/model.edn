   :to :mybank.digital-banking.internet-banking-system/sign-in
   :name "implements"}
  {:el :implements
   :id :mybank.digital-banking.internet-banking-system/reset-password-controller-implements-reset-password
   :from :mybank.digital-banking.internet-banking-system/reset-password-controller
   :to :mybank.digital-banking.internet-banking-system/reset-password
   :name "implements"}
  {:el :implements
   :id :mybank.digital-banking.internet-banking-system/accounts-summary-controller-implements-view-account
