;;;;
;;;; Banking Concept Model
;;;;
#{;
  ;;;
  ;;; Concepts
  ;;; 

  ;; Nodes
  {:el :concept
   :id :mybank.concepts/bank
   :name "Bank"
   :desc "Organization providing services around money"}
  {:el :concept
   :id :mybank.concepts/customer
   :name "Customer"
   :desc "Entity requesting services around money"}
  {:el :concept
   :id :mybank.concepts/personal-customer
   :name "Personal Customer"
   :desc "A person requesting services around money"}
  {:el :concept
   :id :mybank.concepts/corporate-customer
   :name "Corporate Customer"
   :desc "An organization requesting services around money"}
  {:el :concept
   :id :mybank.concepts/account
   :name "Account"
   :desc "Records the financial transactions between a customer and a bank"}
  {:el :concept
   :id :mybank.concepts/transaction
   :name "Transaction"
   :desc "Movement of money recorded on an account"}
  {:el :concept
   :id :mybank.concepts/deposit
   :name "Deposit"
   :desc "Puts money on account"}
  {:el :concept
   :id :mybank.concepts/withdrawal
   :name "Withdrawal"
   :desc "Takes money from account"}
  {:el :concept
   :id :mybank.concepts/transfer
   :name "Transfer"
   :desc "Moves money from one account to another account"}
  {:el :concept
   :id :mybank.concepts/loan
   :name "Loan"
   :desc "Lending money from the bank to the customer"}
  {:el :concept
   :id :mybank.concepts/mortgage
   :name "Mortgage"
   :desc "A loan secured by real estate, e.g. a house"}
  {:el :concept
   :id :mybank.concepts/savings-account
   :name "Savings Account"
   :desc "An account for saving money that earns interest"}
  {:el :concept
   :id :mybank.concepts/checking-account
   :name "Checking Account"
   :desc "An account for everyday payments and transactions"}
  {:el :concept
   :id :mybank.concepts/card
   :name "Card"
   :desc "Payment instrument giving access to an account, e.g. a debit or credit card"}
  {:el :concept
   :id :mybank.concepts/payment
   :name "Payment"
   :desc "Transaction paying a third party"}
  {:el :concept
   :id :mybank.concepts/repayment
   :name "Repayment"
   :desc "Payment of an installment of a loan"}
  {:el :concept
   :id :mybank.concepts/channel
   :name "Channel"
   :desc "Way for the customer to interact with the bank, e.g. branch, ATM or online"}
  {:el :concept
   :id :mybank.concepts/collateral
   :name "Collateral"
   :desc "Asset pledged by the borrower to secure a loan"}
  {:el :concept
   :id :mybank.concepts/risk-assessment
   :name "Risk Assessment"
   :desc "Evaluation of the creditworthiness and risk of a customer"}
  {:el :concept
   :id :mybank.concepts/investment
   :name "Investment"
   :desc "Asset held by a customer to generate return, e.g. securities or funds"}

